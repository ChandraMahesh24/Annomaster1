# ════════════════════════════════════════════════════════════
#  AnnoMaster — files that must NOT go to GitHub
# ════════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
htmlcov/
.coverage

# Virtual environments
venv/
env/
.venv/

# ── Secrets / local config ──────────────────────────────────
# Real keys live in .env; only the template is committed.
.env
.env.*
!.env.example

# ── Database (SQLite + WAL side files) ──────────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite3

# ── User data: images, labels, datasets, versions ──────────
# The top-level workspace/ only — templates/workspace/ is code.
/workspace/
Active_Work/
Completed_Datasets/
uploads/
backups/

# ── AI model weights ────────────────────────────────────────
# GitHub rejects files over 100 MB (sam3.pt is 3.45 GB), and most
# weights are downloaded or supplied by the user. Ignore them all,
# then re-include the small project model that the app ships with.
/*.pt
/*.pth
models/*.pt
models/*.pth
!models/blackshirt_*.pt
*.onnx
*.engine
*.safetensors
mobileclip_*.ts
weights/
runs/
.cache/

# ── Node / frontend (annomaster-next) ───────────────────────
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# ── Archives, temp files, logs ──────────────────────────────
*.zip
*.tmp
*.bak
*.log
3.5.0

# ── Editor / OS ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.claude/
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
