# Copy to .env and fill for production. Dev defaults in config.py let the app
# boot without this file.

DEBUG=true
SECRET_KEY=change-me
JWT_SECRET=change-me

# docker-compose provides these hosts; override for a managed Postgres/Redis.
DATABASE_URL=postgresql+psycopg://annomaster:annomaster@localhost:5432/annomaster
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

WORKSPACE_ROOT=./workspace
MODELS_DIR=./models

CORS_ORIGINS=["http://localhost:5173"]
