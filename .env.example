SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
DATABASE_URL=sqlite:///annomaster.db
JWT_EXPIRY_HOURS=24

# Password reset. Leave MAIL_SERVER empty to log reset links to the console instead.
APP_BASE_URL=http://localhost:5000
RESET_TOKEN_MINUTES=30
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# AI compute device (Smart Detect + AI Annotate). auto = GPU if torch can see
# one, else CPU; a GPU failure (e.g. out of memory) falls back to CPU by itself.
# AI_DEVICE=auto        # auto | cpu | cuda | cuda:1
# AI_HALF=auto          # auto = fp16 on GPU; 0 = always fp32
